# Recommended: Groq (used by this project)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional live web search
TAVILY_API_KEY=

# Optional alternative LLM providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional explicit provider: groq, openai, or anthropic
LLM_PROVIDER=groq
